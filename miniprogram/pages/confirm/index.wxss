.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.section { margin-bottom: 24rpx; }
.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin: 8rpx 0 14rpx 8rpx;
}

/* ===== 商品 ===== */
.item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F6F7F6;
}
.item-main { flex: 1; min-width: 0; }
.item-name { font-size: 28rpx; }
.item-spec { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.item-qty { font-size: 24rpx; color: var(--ink-3); margin: 0 24rpx; }
.item-amount { font-size: 26rpx; font-weight: 600; }

.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 12rpx 0;
}
.fee-row.total {
  border-top: 1rpx solid var(--line);
  margin-top: 8rpx;
  padding-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-1);
  font-weight: 600;
}
.fee-row .amount { color: var(--brand); font-size: 32rpx; }
.cal-line {
  margin-top: 6rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ===== 表单 ===== */
.form-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F6F7F6;
}
.form-row:last-child { border-bottom: none; }
.label {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.input {
  flex: 1;
  font-size: 28rpx;
  height: 56rpx;
}
.remark {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
}

/* ===== 提交栏 ===== */
.bottom-space { height: 180rpx; }
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  background: #fff;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
}
.submit-total { flex: 1; }
.submit-amount { font-size: 36rpx; font-weight: 700; color: var(--ink-1); }
.submit-cal { font-size: 20rpx; color: var(--ink-3); }
.submit-btn {
  min-width: 260rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn.disabled { background: #C9E5D8; }
