.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ===== 顶部 ===== */
.header {
  padding: 36rpx 32rpx 28rpx;
  background: var(--brand-deep);
  color: #fff;
  flex-shrink: 0;
}
.brand { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.slogan { margin-top: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.66); }

/* ===== 类目 ===== */
.cats {
  flex-shrink: 0;
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.cat {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #F4F6F5;
}
.cat.active {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

/* ===== 列表 ===== */
.list {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin: 26rpx 0 12rpx 8rpx;
}
.dish {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius);
  padding: 22rpx;
  margin-bottom: 16rpx;
}
.thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.info { flex: 1; margin-left: 20rpx; min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; }
.desc {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta { margin-top: 10rpx; display: flex; align-items: center; }
.price { color: var(--brand); font-size: 28rpx; font-weight: 700; }
.cal { color: var(--ink-3); font-size: 22rpx; margin-left: 14rpx; }
.spec-flag {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}
.add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.add.disabled {
  background: #E5E7E6;
  color: var(--ink-3);
  font-size: 20rpx;
}
.list-bottom { height: 180rpx; }

/* ===== 状态 ===== */
.state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  font-size: 26rpx;
}
.retry {
  margin-top: 24rpx;
  padding: 14rpx 40rpx;
  background: var(--brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
}

/* ===== 购物车条 ===== */
.cartbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  height: 100rpx;
  background: var(--brand-deep);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(20, 83, 45, 0.28);
}
.cart-left { flex: 1; color: #fff; }
.cart-amount { font-size: 32rpx; font-weight: 700; }
.cart-cal { font-size: 20rpx; color: rgba(255, 255, 255, 0.66); }
.cart-go {
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
}

/* ===== 规格弹层 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}
.sku {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  z-index: 11;
  animation: rise 0.22s ease-out;
}
@keyframes rise {
  from { transform: translateY(40rpx); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}
.sku-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.sku-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sku-title { margin-left: 20rpx; }
.sku-name { font-size: 30rpx; font-weight: 600; }
.sku-price { color: var(--brand); font-size: 28rpx; font-weight: 700; margin-top: 6rpx; }
.sku-group { margin-top: 22rpx; }
.sku-group-title { font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; }
.sku-opts { display: flex; flex-wrap: wrap; }
.sku-opt {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--ink-2);
  margin: 0 14rpx 14rpx 0;
}
.sku-opt.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 600;
}
.sku-actions {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.qty { display: flex; align-items: center; }
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink-2);
}
.qty-val { width: 72rpx; text-align: center; font-size: 28rpx; }
.sku-confirm {
  flex: 1;
  margin-left: 28rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== AI 定制入口 ===== */
.plan-entry {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #EAF7F0, #F6FBF8);
  border: 1rpx solid #CBE7D8;
}
.plan-icon { font-size: 34rpx; margin-right: 16rpx; }
.plan-text { flex: 1; }
.plan-title { font-size: 26rpx; font-weight: 700; color: var(--brand-deep); }
.plan-sub { margin-top: 4rpx; font-size: 20rpx; color: var(--ink-3); }
.plan-arrow { font-size: 32rpx; color: var(--brand); }