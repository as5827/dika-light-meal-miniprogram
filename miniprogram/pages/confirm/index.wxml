<view class="page">

  <view class="section">
    <view class="section-title">订单商品</view>
    <view class="card">
      <view wx:for="{{items}}" wx:key="key" class="item">
        <view class="item-main">
          <view class="item-name">{{item.name}}</view>
          <view wx:if="{{item.specDesc}}" class="item-spec">{{item.specDesc}}</view>
        </view>
        <view class="item-qty">×{{item.qty}}</view>
        <view class="item-amount">¥{{item.amountText}}</view>
      </view>

      <view class="fee-row">
        <text>商品小计</text><text>¥{{subtotalText}}</text>
      </view>
      <view class="fee-row">
        <text>配送费</text><text>{{deliveryText}}</text>
      </view>
      <view class="fee-row">
        <text>打包费</text><text>{{packText}}</text>
      </view>
      <view class="fee-row total">
        <text>合计</text><text class="amount">¥{{totalText}}</text>
      </view>
      <view class="cal-line">共 {{calorie}} kcal</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">收货地址</view>
    <view class="card">
      <view class="form-row">
        <text class="label">楼栋</text>
        <input class="input" placeholder="如：3 号楼" value="{{building}}" data-field="building" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">门牌号</text>
        <input class="input" placeholder="如：302 室" value="{{room}}" data-field="room" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">联系人</text>
        <input class="input" placeholder="收货人姓名" value="{{name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">备注</view>
    <view class="card">
      <textarea class="remark" placeholder="口味偏好、餐具需求等（选填）" maxlength="200" value="{{remark}}" data-field="remark" bindinput="onInput" />
    </view>
  </view>

  <view class="bottom-space"></view>

  <view class="submit-bar">
    <view class="submit-total">
      <view class="submit-amount">¥{{totalText}}</view>
      <view class="submit-cal">共 {{calorie}} kcal</view>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交订单'}}
    </view>
  </view>

</view>
