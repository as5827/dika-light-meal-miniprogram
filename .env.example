# 环境变量模板
# 复制为 .env 仅作说明用途：本项目零依赖、不读取 .env 文件，
# 变量请以系统环境变量方式传入（见 README 第四节）。

# 服务监听端口
PORT=3000

# 后台登录账号（不设置时使用默认 admin / dika2026）
# ⚠️ 默认口令仅用于本地演示与评审复现，部署到公网前必须覆盖
ADMIN_USER=admin
ADMIN_PASSWORD=dika2026

# 可选：推荐结果的文案润色（不配置则只用模板文案，接口行为不变）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 日志：级别 debug/info/warn/error；LOG_TO_FILE=0 时只打控制台
LOG_LEVEL=info
LOG_TO_FILE=1